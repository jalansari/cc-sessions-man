{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run flake8:*)",
      "Bash(uv run black:*)",
      "Bash(uv run isort:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
